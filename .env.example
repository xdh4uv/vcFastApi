DATABASE_URL=postgresql://postgres:password@localhost:5432/vcfastapi
# Optional direct Neon URL used only by migrations (no -pooler in hostname).
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/vchitr-main?sslmode=require
JWT_SECRET=supersecretkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Comma-separated exact-match origins. Vercel deploys matched via CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)?vercel\.app
# Set to mounted-volume path in prod (Render/Fly disk). Default is ephemeral.
UPLOADS_DIR=uploads
# Operator-only lesson pre-generation. Never expose these through VITE_* variables.
# CONTENT_PROVIDER=openai-compatible
# CONTENT_API_BASE_URL=https://integrate.api.nvidia.com/v1
# CONTENT_API_KEY=
# CONTENT_MODEL=your-selected-model-id
# CONTENT_OUTPUT_MODE=json_object
# Enable only after migration 003 has been applied to this environment.
CONTENT_PIPELINE_ENABLED=false
# Automatic cache-miss drafts require V9 and DATABASE_URL using vchitr_runtime.
AUTOMATIC_LESSONS_ENABLED=false
TIERED_TESTS_ENABLED=false
LESSON_GENERATIONS_PER_DAY=12
LESSON_REQUESTS_PER_USER_DAY=6
# Optional bounded request settings. Leave unset for the original 6000-token, non-streaming defaults.
# CONTENT_STREAM=true
# CONTENT_MAX_TOKENS=16384
# CONTENT_READ_TIMEOUT=180
# CONTENT_TEMPERATURE=1
# CONTENT_TOP_P=0.95
# NIM defaults to thinking=false. Optional NIM-only override; unset when switching providers.
# CONTENT_ENABLE_THINKING=false
# OpenRouter: CONTENT_API_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA NIM: CONTENT_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Groq GPT-OSS: CONTENT_API_BASE_URL=https://api.groq.com/openai/v1
# CONTENT_MODEL=openai/gpt-oss-120b
# CONTENT_REASONING_EFFORT=medium
# For Groq JSON Schema output, use CONTENT_OUTPUT_MODE=json_schema and CONTENT_STREAM=false.
# Start with CONTENT_MAX_TOKENS=4096; free-plan token limits also include the prompt.
# Remove NIM thinking overrides when switching providers. Groq options are scoped to GPT-OSS.
# OpenAI: CONTENT_PROVIDER=openai; CONTENT_API_BASE_URL=https://api.openai.com/v1
# Anthropic: CONTENT_PROVIDER=anthropic; CONTENT_API_BASE_URL=https://api.anthropic.com/v1

# Enable after Flyway migrations V4-V6. Independent of lesson publishing.
ENGAGEMENT_ENABLED=false
READING_TEST_THRESHOLD=75
# Enable only when a working tutor provider is configured.
TUTOR_ENABLED=false
# NIM tutor defaults to thinking=false independently of CONTENT_ENABLE_THINKING.
# Leave unset for other providers. Set true only after checking latency/token budget.
# TUTOR_ENABLE_THINKING=false
# Optional Groq GPT-OSS effort (low, medium, high); defaults to medium. Unset for other providers.
# TUTOR_REASONING_EFFORT=medium
TUTOR_TEMPERATURE=0.2
TUTOR_MAX_TOKENS=1536
TUTOR_READ_TIMEOUT=45
