# Local docker-compose settings. Copy to .env.docker (git-ignored) and adjust.
# Database URLs are set by docker-compose.yaml and point at the local container.

JWT_SECRET=local-dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=600

# Google sign-in (optional). Add http://localhost:5173 to the OAuth client's
# authorised JavaScript origins. Leave blank to use password login only.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Adapted lessons stay off locally unless you are working on the content pipeline.
CONTENT_PIPELINE_ENABLED=false
