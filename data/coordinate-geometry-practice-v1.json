{
  "courseId": "ncert-maths-10-v1",
  "chapterId": "ch-07",
  "concepts": [
    {
      "id": "distance",
      "title": "Distance between points",
      "legacyLabels": [
        "distance"
      ],
      "explanation": "Distance is √[(x₂ − x₁)² + (y₂ − y₁)²]. Horizontal or vertical distances are absolute coordinate differences.",
      "example": {
        "problem": "Find the distance between (0, 0) and (6, 8).",
        "steps": [
          "Distance² = 36 + 64 = 100.",
          "Distance = 10.",
          "Answer: 10."
        ]
      },
      "commonMistake": "A coordinate difference may be negative, but distance cannot be.",
      "checklist": [
        "Subtract matching coordinates.",
        "Square and add.",
        "Take the nonnegative square root."
      ]
    },
    {
      "id": "midpoint",
      "title": "Midpoints",
      "legacyLabels": [
        "midpoint"
      ],
      "explanation": "The midpoint averages corresponding coordinates: ((x₁ + x₂)/2, (y₁ + y₂)/2). You can rearrange to find a missing endpoint.",
      "example": {
        "problem": "The midpoint of A(-2, 2) and B(x, 10) has x-coordinate 4. Find x.",
        "steps": [
          "(-2 + x)/2 = 4.",
          "x = 10.",
          "Answer: 10."
        ]
      },
      "commonMistake": "Average x with x and y with y, not x with y.",
      "checklist": [
        "Write the two coordinate averages.",
        "Solve missing coordinates separately.",
        "Check the midpoint lies between endpoints."
      ]
    },
    {
      "id": "section",
      "title": "Internal division of a segment",
      "legacyLabels": [
        "section formula"
      ],
      "explanation": "If AP:PB = m:n, then P = ((mxB + nxA)/(m+n), (myB + nyA)/(m+n)). The coordinate of the opposite endpoint receives each weight.",
      "example": {
        "problem": "P divides A(-2, 2), B(10, 14) internally with AP:PB = 2:1. Find Py.",
        "steps": [
          "Py = (2 × 14 + 2)/3 = 10.",
          "Answer: 10."
        ]
      },
      "commonMistake": "Reversing the weights generally places the point on the wrong side of the midpoint.",
      "checklist": [
        "Label A, B and the ratio order.",
        "Use opposite endpoint weights.",
        "Check P lies inside AB."
      ]
    },
    {
      "id": "equidistant",
      "title": "Equidistant points",
      "legacyLabels": [
        "equal distances"
      ],
      "explanation": "Set the squared distances to the two given points equal. Squaring avoids unnecessary square roots; expand carefully to solve the remaining coordinate.",
      "example": {
        "problem": "Point (x, 0) is equidistant from (-2, 2) and (6, 2). Find x.",
        "steps": [
          "(x + 2)² + 4 = (x − 6)² + 4.",
          "Expansion gives x = 2.",
          "Answer: 2."
        ]
      },
      "commonMistake": "Equal distances do not mean equal x-coordinates.",
      "checklist": [
        "Write both squared distances.",
        "Expand and cancel common terms.",
        "Substitute the coordinate into both distances."
      ]
    },
    {
      "id": "coordinate-shapes",
      "title": "Lengths in coordinate figures",
      "legacyLabels": [],
      "explanation": "Use the distance formula to find side lengths, compare squared lengths to recognise figures, and add lengths for perimeter.",
      "example": {
        "problem": "A rhombus has vertices (6,0), (0,8), (-6,0), (0,-8). Find its perimeter.",
        "steps": [
          "Each side has length √(36+64) = 10.",
          "Perimeter = 40.",
          "Answer: 40."
        ]
      },
      "commonMistake": "A diagonal and a side are different lengths.",
      "checklist": [
        "Label which points are joined.",
        "Compute all needed distances.",
        "Use the geometry only after checking lengths."
      ]
    }
  ],
