{
  "courseId": "ncert-maths-10-v1",
  "chapterId": "ch-05",
  "concepts": [
    {
      "id": "difference",
      "title": "Common difference",
      "legacyLabels": [
        "common difference"
      ],
      "explanation": "In an AP, subtract each term from the next: the same difference d must recur. For indexed terms, aⱼ − aᵢ = (j − i)d.",
      "example": {
        "problem": "Three consecutive AP terms are 2, k, 10. Find k.",
        "steps": [
          "The middle term is their average: (2 + 10)/2 = 6.",
          "Answer: 6."
        ]
      },
      "commonMistake": "Do not reverse the subtraction or confuse index gaps with term values.",
      "checklist": [
        "Subtract in order.",
        "Check another consecutive pair.",
        "Divide an indexed term difference by the index gap."
      ]
    },
    {
      "id": "nth-term",
      "title": "Finding an nth term",
      "legacyLabels": [
        "nth term"
      ],
      "explanation": "The nth term is aₙ = a + (n − 1)d, where a is the first term. There are n − 1 steps from the first term to the nth.",
      "example": {
        "problem": "Find a₁₂ for the AP 20, 18, 16, ….",
        "steps": [
          "d = -2; a₁₂ = 20 - 11 × 2 = -2.",
          "Answer: -2."
        ]
      },
      "commonMistake": "Using nd instead of (n − 1)d shifts the result by one term.",
      "checklist": [
        "Identify a and d.",
        "Count n − 1 steps.",
        "Add the change to a."
      ]
    },
    {
      "id": "sum",
      "title": "Sum of an AP",
      "legacyLabels": [
        "sum"
      ],
      "explanation": "Sₙ = n[2a + (n − 1)d]/2, or n(a + l)/2 when the last term l is known. Pairing opposite-end terms explains the formula.",
      "example": {
        "problem": "Find the sum of the first 10 terms of 2, 4, 6, ….",
        "steps": [
          "The last term is 20.",
          "S₁₀ = 10(2 + 20)/2 = 110.",
          "Answer: 110."
        ]
      },
      "commonMistake": "The nth term is not the sum of the first n terms.",
      "checklist": [
        "Find the term count.",
        "Find the last term if useful.",
        "Multiply count by average of first and last."
      ]
    },
    {
      "id": "position",
      "title": "Locating a term",
      "legacyLabels": [
        "term position"
      ],
      "explanation": "Set the target equal to a + (n − 1)d and solve for n. A target is a term only if the resulting index is a positive integer.",
      "example": {
        "problem": "Which term of 20, 18, 16, … is zero?",
        "steps": [
          "0 = 20 − (k − 1)2, so k = 11.",
          "Answer: 11."
        ]
      },
      "commonMistake": "A fractional index does not name a term in the AP.",
      "checklist": [
        "Write the target equation.",
        "Solve for n.",
        "Check positivity and integrality."
      ]
    },
    {
      "id": "recovering",
      "title": "Recovering an AP",
      "legacyLabels": [
        "recovering an AP"
      ],
      "explanation": "Two indexed terms give the common difference by subtraction. Substitute d into either aₙ equation to recover the first term.",
      "example": {
        "problem": "An AP has a₃ = 14, a₆ = 26. Find a.",
        "steps": [
          "d = 12/3 = 4.",
          "a = a₃ − 2d = 6.",
          "Answer: 6."
        ]
      },
      "commonMistake": "Subtract indices as well as values.",
      "checklist": [
        "Use the gap between indices.",
        "Recover d first.",
        "Substitute to obtain a."
      ]
    }
  ],
